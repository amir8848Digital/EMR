# Config for docker/bench-image/docker-compose.yml
#   cp docker/bench-image/.env.example docker/bench-image/.env

# Must match the db_user/db_password in the site_config.json you were given,
# or the bench cannot connect to the restored database.
MARIADB_ROOT_PASSWORD=change-me
FRAPPE_DB_NAME=demo_site
FRAPPE_DB_USER=demo_site
FRAPPE_DB_PASSWORD=change-me

FRAPPE_SITE=demo.localhost

# 3306/3307 are often taken on a dev box
MARIADB_HOST_PORT=3308
FRAPPE_PORT=8002
FRAPPE_SOCKETIO_PORT=9002

# Override to test a locally built image instead of pulling
# BENCH_IMAGE=emr-bench:local
