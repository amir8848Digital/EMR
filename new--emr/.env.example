# Template for the root .env file — COMMITTED (unlike .env itself, which is gitignored).
#
# First-time setup:
#   cp .env.example .env
# then edit .env if any value needs to differ from the shared dev defaults below (most
# people won't need to change anything for local dev).
#
# Both docker-compose.yml (build mode) and docker-compose.dev.yml (dev mode) read every
# value below via Compose's ${VAR} substitution — nothing is hardcoded in either file.

# COMPOSE_FILE — a Docker Compose–recognized special variable (not read by the app at
# all): it tells the *compose CLI itself* which file plain `docker compose <command>`
# should use, without you typing `-f docker-compose.dev.yml` every time.
#
#   COMPOSE_FILE=docker-compose.dev.yml
#     → `docker compose up` = dev mode (live-reload, mounts your source, no rebuild
#       needed on save) — this is the default here, since that's what you want 90% of
#       the time while actively coding.
#
# To reach BUILD mode (bakes source into real images, production-style) instead, either:
#   - use the explicit flag once: docker compose -f docker-compose.yml up -d --build
#   - or change this line locally to COMPOSE_FILE=docker-compose.yml (not recommended to
#     commit that change — dev mode is the intended shared default for everyone)
#
# See DOCKER.md for the full dev-vs-build explanation.
COMPOSE_FILE=docker-compose.dev.yml

# ── Host ports (left side of "HOST:CONTAINER" in each compose file's ports:) ──────────
BACKEND_PORT=8000
FRONTEND_PORT=3001

# ── Database — points at a DB container/instance you run separately (this repo
# doesn't manage one — see DOCKER.md's Database section) ──────────────────────────────
# backend reaches it via host.docker.internal (Docker's cross-platform name for "the
# machine Docker itself is running on") — leave DB_HOST as-is unless your DB genuinely
# lives somewhere else.
#
# DB_CLIENT selects the adapter in emr_node/database/index.js:
#   mssql            (default; anything unrecognised also falls here)  port 1433
#   pg | postgres                                                      port 5432
#   mariadb | mysql                                                    port 3306
# Set DB_PORT to match the engine you pick.
DB_CLIENT=mssql
DB_USER=sa
DB_HOST=host.docker.internal
DB_NAME=Emr
DB_PASSWORD=Password1!
DB_PORT=1433

# ── Backend secrets/config — shared dev-only defaults, fine to keep as-is locally.
# Never reuse these values for a real/production deployment. ──────────────────────────
ENCRYPTION_KEY=admin@1234
JWT_SECRET=admin@1234
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=12345
COCD=MW

# ── Frontend — NEXT_PUBLIC_* values get baked directly into the browser-visible JS
# bundle (build mode) or read when `next dev` starts (dev mode) — never put anything
# secret in a NEXT_PUBLIC_* variable, it's shipped to every visitor's browser. ────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL_CUSTOM=http://localhost:8001
NEXT_PUBLIC_CLIENT_NAME=KBS
