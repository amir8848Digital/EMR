# ─────────────────────────────────────────────────────────────────────────────
# Root compose config.  cp .env.example .env  and fill in the two passwords.
#
# This file only configures docker-compose.yml. Each app keeps reading its own
# .env (new--emr/.env, DC/EMR_Catalog_Backend/.env, ...) exactly as before —
# compose overrides only the handful of values that must differ inside a
# container, such as a DB host or a service-to-service URL.
# ─────────────────────────────────────────────────────────────────────────────

# Own the files the containers write into the bind-mounted source (.next caches,
# logs). Set these to your own ids: `id -u` and `id -g`.
HOST_UID=1000
HOST_GID=1000

# ── database ────────────────────────────────────────────────────────────────
# FRAPPE_DB_* must match demo-bench/sites/demo.localhost/site_config.json, and
# the DB_USER/DB_PASSWORD/DB_DATABASE in the three EMR_Catalog_Backend .env
# files — they all share this one database.
MARIADB_ROOT_PASSWORD=change-me
FRAPPE_DB_NAME=demo_site
FRAPPE_DB_USER=demo_site
FRAPPE_DB_PASSWORD=change-me
# 3306 and 3307 are usually taken on a dev box (host mariadb, mariadb-emr6122)
MARIADB_HOST_PORT=3308

FRAPPE_SITE=demo.localhost

# ── host ports ──────────────────────────────────────────────────────────────
# WARNING: these are registered in AuthService as each client's redirect and
# back-channel URLs. Change one and SSO breaks for that app until you update
# its client record at http://localhost:4000/admin.
AUTH_PORT=4000
FRAPPE_PORT=8002
FRAPPE_SOCKETIO_PORT=9002
CRM_PORT=3000
EMR_FRONTEND_PORT=3001
EMR_BACKEND_PORT=8000
DC_WEB_PORT=3002
DC_BACKEND_PORT=5001
PD_PORT=3003
WT_WEB_PORT=3004
WT_BACKEND_PORT=5091
POS_WEB_PORT=3006
POS_BACKEND_PORT=5003
