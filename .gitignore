# ── secrets ─────────────────────────────────────────────────────────────────
# Real local config. Copy .env.example to .env instead of committing this file:
# it holds MARIADB_ROOT_PASSWORD and the demo_site password.
.env
# every app keeps its own, and the stray backup copies are just as secret
.env.*
!.env.example
**/local-clients.env
# Frappe writes db_password and encryption_key in clear text here
**/site_config.json
**/site_config_backup.json
# signing keypairs (AuthService) and redis ACLs
**/*.jwk.json
**/*.acl
# .npmrc carries registry auth tokens (the @8848digital scope needs one).
# Keep it local; never commit it.
**/.npmrc

# stray artifact, not real config
POS/package-lock.json

# ── Frappe benches ──────────────────────────────────────────────────────────
# NOT in this repo, and demo-bench cannot be: it is not a git repo, its nine
# apps have no `origin` (only `upstream`), and `emr_sso` has no remote at all
# plus uncommitted work — the copy on disk is the only one in existence.
# PD/frappe-bench is a second, 1.7GB bench carrying live site configs and
# database backups. Both are tens of GB with node_modules and built assets.
# See DOCKER.md.
demo-bench/
frappe-bench/

# ── data: never in a public repo ────────────────────────────────────────────
# The demo_site database is ~4.7GB of real business data and is shared
# separately by the repo owner, never through git. docker/db-init stays as the
# drop-in point: anything placed there is imported on first start.
docker/db-init/*
!docker/db-init/README.md
!docker/db-init/.gitkeep

# Same for the standalone bench image: db-init takes the dump, and handover/ is
# where a site directory lands — and a site_config.json holds the db password
# and the encryption_key in clear text.
docker/bench-image/db-init/*
!docker/bench-image/db-init/.gitkeep
docker/bench-image/handover/*
!docker/bench-image/handover/.gitkeep
**/private/backups/
*.sql
*.sql.gz
*.dump
*.tar
*.tar.gz
*.zip

# ── generated / machine-local ───────────────────────────────────────────────
node_modules/
.next/
.turbo/
.run-logs/
*.log

# ── editor / OS ─────────────────────────────────────────────────────────────
.DS_Store
*.swp
